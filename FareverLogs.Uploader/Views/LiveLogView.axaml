<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FareverLogs.Uploader.ViewModels"
             x:Class="FareverLogs.Uploader.Views.LiveLogView"
             x:DataType="vm:LiveLogViewModel">

    <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">

        <!-- Start / Stop -->
        <Button Grid.Row="0"
                Content="{Binding StartButtonLabel}"
                Command="{Binding ToggleCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />

        <!-- Log output -->
        <Border Grid.Row="1" Classes="Panel" Padding="4" Margin="0,12,0,0">
            <ListBox x:Name="LogBox"
                     ItemsSource="{Binding LogMessages}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogEntry">
                        <StackPanel>
                            <TextBlock Text="{Binding Text}"
                                       Classes="MonoMuted"
                                       TextWrapping="Wrap" />
                            <Button Content="{Binding Url}"
                                    IsVisible="{Binding HasUrl}"
                                    Classes="Link"
                                    Click="OnUrlClick"
                                    Tag="{Binding Url}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </Grid>
</UserControl>
