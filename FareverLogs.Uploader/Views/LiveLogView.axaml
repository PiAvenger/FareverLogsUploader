<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FareverLogs.Uploader.ViewModels"
             x:Class="FareverLogs.Uploader.Views.LiveLogView"
             x:DataType="vm:LiveLogViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">

        <!-- Header: back + title -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0"
                    Content="← Back"
                    Command="{Binding BackCommand}"
                    Classes="Ghost" />
            <TextBlock Grid.Column="1"
                       Text="Live Log"
                       Classes="Heading"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </Grid>

        <!-- Server URL (read-only) -->
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,0">
            <TextBlock Text="Server" Classes="Heading" />
            <TextBlock Text="{Binding ServerUrl}"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="13" />
        </StackPanel>

        <!-- Start / Stop -->
        <Button Grid.Row="2"
                Margin="0,12,0,0"
                Content="{Binding StartButtonLabel}"
                Command="{Binding ToggleCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />

        <!-- Log output -->
        <Border Grid.Row="3" Classes="Panel" Padding="4" Margin="0,12,0,0">
            <ListBox x:Name="LogBox"
                     ItemsSource="{Binding LogMessages}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogEntry">
                        <StackPanel>
                            <TextBlock Text="{Binding Text}"
                                       Classes="MonoMuted"
                                       TextWrapping="Wrap" />
                            <Button Content="{Binding Url}"
                                    IsVisible="{Binding HasUrl}"
                                    Classes="Link"
                                    Click="OnUrlClick"
                                    Tag="{Binding Url}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </Grid>
</UserControl>
