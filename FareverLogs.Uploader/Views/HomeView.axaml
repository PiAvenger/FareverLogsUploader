<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FareverLogs.Uploader.ViewModels"
             xmlns:views="clr-namespace:FareverLogs.Uploader.Views"
             x:Class="FareverLogs.Uploader.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid RowDefinitions="Auto,*" Margin="24">

        <!-- Welcome header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Welcome back," Foreground="{StaticResource TextMuted}" FontSize="12" />
            <TextBlock Text="{Binding Username}" Classes="Heading" FontSize="22" />
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1">
            <TabItem Header="Live Log">
                <views:LiveLogView DataContext="{Binding LiveLog}" />
            </TabItem>
            <TabItem Header="Upload Existing">
                <views:UploadExistingView DataContext="{Binding UploadExisting}" />
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
